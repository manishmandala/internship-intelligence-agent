# Copy this file to .env and adjust values as needed.
# None of these are required to run the project with default settings.

# Path to the SQLite database file (relative to project root).
IIA_DB_PATH=data/internships.db

# Directory where log files are written.
IIA_LOG_DIR=logs

# Seconds to wait between HTTP requests to the same source (politeness delay).
IIA_REQUEST_DELAY_SECONDS=1.5

# HTTP request timeout in seconds.
IIA_REQUEST_TIMEOUT_SECONDS=15

# Max retries per request before a source is marked failed for that request.
IIA_MAX_RETRIES=3

# Contact info included in the User-Agent string sent to career sites,
# so a site operator can identify and reach out about this bot if needed.
IIA_CONTACT_EMAIL=manish.mandala07@gmail.com

# Reserved for a future optional LLM-based scoring backend (not required today).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
